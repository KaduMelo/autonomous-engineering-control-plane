# Copy to .env and fill in. .env is gitignored.
#
# Nothing here is needed to run the tests or either demo: the repository host is
# a local stand-in and the fixer can be scripted. These are for pointing the
# control plane at real services.

# Read inside the propose_fix activity only. Never enters workflow code, and
# never enters the validation sandbox - the container is started with no --env.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret for the webhook HMAC. The ingress refuses to start without it,
# because an unset secret would reject every notification.
CONTROL_PLANE_WEBHOOK_SECRET=change-me

# Read inside the open_pr activity only. Minimum scope: push a branch and open a
# pull request. No merge scope is requested, so FR-013 is enforced by the
# credential and not only by the code.
CONTROL_PLANE_HOST_TOKEN=ghp_...

# Optional overrides. Defaults are in src/control_plane/config.py and all point
# at this machine.
# TEMPORAL_TARGET=localhost:7233
# CONTROL_PLANE_TASK_QUEUE=fix-loop
# CONTROL_PLANE_INGRESS_HOST=127.0.0.1
# CONTROL_PLANE_INGRESS_PORT=8080
# CONTROL_PLANE_HOST_API=http://127.0.0.1:8099
# SANDBOX_IMAGE=fixloop-sandbox:latest
# CONTROL_PLANE_MODEL=claude-opus-5
# CONTROL_PLANE_WORKSPACE_ROOT=/path/to/scratch
# CONTROL_PLANE_CLONE_ROOT=/path/to/clones
