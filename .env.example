# Copy to .env and fill in. .env is gitignored.
#
# The control plane reads this credential inside the propose_fix activity only.
# It never enters workflow code, and it never enters the validation sandbox -
# the container is started with no --env at all.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides. Defaults are in src/control_plane/config.py.
# TEMPORAL_TARGET=localhost:7233
# CONTROL_PLANE_TASK_QUEUE=fix-loop
# SANDBOX_IMAGE=fixloop-sandbox:latest
# CONTROL_PLANE_MODEL=claude-opus-5
# CONTROL_PLANE_WORKSPACE_ROOT=/path/to/scratch
